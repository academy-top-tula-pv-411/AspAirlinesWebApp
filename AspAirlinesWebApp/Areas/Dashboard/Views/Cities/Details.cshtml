@model AspAirlinesWebApp.Models.City

@{
    ViewData["Title"] = "Details";
}

<h4>Details City</h4>
<div>
    
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airports)
        </dt>
        <dd class = "col-sm-10">
            <ul class="list-group">
                @foreach(var port in Model.Airports)
                {
                    <li class="list-group-item">@port.Title</li>
                }
            </ul>
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airlines)
        </dt>
        <dd class = "col-sm-10">
            <ul class="list-group">
                @foreach (var line in Model.Airlines)
                {
                    <li class="list-group-item">@line.Title</li>
                }
            </ul>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id"  class="btn btn-sm btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-sm btn-success">Back to List</a>
</div>
