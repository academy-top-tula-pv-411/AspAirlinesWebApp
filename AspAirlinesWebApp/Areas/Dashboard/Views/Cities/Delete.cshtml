@model AspAirlinesWebApp.Models.City

@{
    ViewData["Title"] = "Delete";
}
<h4>Are you sure you want to delete this City?</h4>
<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airports)
        </dt>
        <dd class = "col-sm-10">
            <ul class="list-group">
                @foreach (var port in Model.Airports)
                {
                    <li class="list-group-item">@port.Title</li>
                }
            </ul>
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airlines)
        </dt>
        <dd class = "col-sm-10">
            <ul class="list-group">
                @foreach (var line in Model.Airlines)
                {
                    <li class="list-group-item">@line.Title</li>
                }
            </ul>
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-sm btn-danger" /> |
        <a asp-action="Index" class="btn btn-sm btn-success">Back to List</a>
    </form>
</div>
