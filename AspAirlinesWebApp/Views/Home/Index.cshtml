@using AspAirlinesWebApp.ViewModels
@model IndexViewModel

    <div class="table-responsive">
      <table class="table text-center">
        <thead>
          <tr>
            <th>Flight Title</th>
            <th>
                 <a asp-action="Index" asp-route-property-sort=""
                                        asp-route-direction-sort="">Airline</a>
            </th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Date</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
            @foreach(var f in Model)
            {
                <tr>
                    <td>@f.Title</td>
                    <td>@f.Airline?.Title</td>
                    <td>@f.Departure?.Title (@f.Departure?.City?.Title)</td>
                    <td>@f.Arrival?.Title (@f.Arrival?.City?.Title)</td>
                    <td>@f.DateFlight.ToShortDateString()</td>
                    <td>@f.TimeFlight.ToShortTimeString()</td>
                </tr>
            }
        </tbody>

        
      </table>
    </div>

