@using AspAirlinesWebApp.ViewModels

@addTagHelper *, AspAirlinesWebApp

@model IndexViewModel

    <div class="table-responsive">
        <form method="get" class="mb-5 form-control">
            <div class="input-group">
                <input hidden="hidden" name="sortState" value="@Model.SortViewModel.CurrentState" />
                <input hidden="hidden" name="pageSize" value="@Model.PageViewModel.PageSize" />

                <label class="form-control">Airline</label>
                <select class="form-control" name="airline" asp-items="Model.FilterViewModel.Airlines"></select>

                <label class="form-control">Airport</label>
                <select class="form-control" name="airport" asp-items="Model.FilterViewModel.Airports"></select>

                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
            </div>
        </form>

      <table class="table text-left">
        <thead>
          <tr>
            <th>Flight Title</th>
            <th>
                 @* <a asp-action="Index" asp-route-sortState="@Model.SortViewModel.AirlineState">Airline</a> *@
                 <sort action="Index" current="@Model.SortViewModel.CurrentState"
                                     property="@Model.SortViewModel.AirlineState"
                                     airline="@Model.FilterViewModel.SelectedAirline"
                                     airport="@Model.FilterViewModel.SelectedAirport"
                                     page="@Model.PageViewModel.ActivePage"
                                     page-size="@Model.PageViewModel.PageSize">
                     Airline               
                </sort>
            </th>
            <th>
                 @* <a asp-action="Index" asp-route-sortState="@Model.SortViewModel.DepartureState">Departure</a> *@
                 <sort action="Index" current="@Model.SortViewModel.CurrentState"
                                     property="@Model.SortViewModel.DepartureState"
                                     airline="@Model.FilterViewModel.SelectedAirline"
                                     airport="@Model.FilterViewModel.SelectedAirport"
                                     page="@Model.PageViewModel.ActivePage"
                                     page-size="@Model.PageViewModel.PageSize">
                     Departure               
                </sort>
            </th>
            <th>
                <sort action="Index" current="@Model.SortViewModel.CurrentState"
                                     property="@Model.SortViewModel.ArrivalState"
                                     airline="@Model.FilterViewModel.SelectedAirline"
                                     airport="@Model.FilterViewModel.SelectedAirport"
                                     page="@Model.PageViewModel.ActivePage"
                                     page-size="@Model.PageViewModel.PageSize">
                     Arrival               
                </sort>
            </th>
            <th>
                <sort action="Index" current="@Model.SortViewModel.CurrentState"
                                     property="@Model.SortViewModel.DateState"
                                     airline="@Model.FilterViewModel.SelectedAirline"
                                     airport="@Model.FilterViewModel.SelectedAirport"
                                     page="@Model.PageViewModel.ActivePage"
                                     page-size="@Model.PageViewModel.PageSize">
                     Date               
                </sort>
            </th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
            @foreach(var f in Model.Flights)
            {
                <tr>
                    <td>@f.Title</td>
                    <td>@f.Airline?.Title</td>
                    <td>@f.Departure?.Title (@f.Departure?.City?.Title)</td>
                    <td>@f.Arrival?.Title (@f.Arrival?.City?.Title)</td>
                    <td>@f.DateFlight.ToShortDateString()</td>
                    <td>@f.TimeFlight.ToShortTimeString()</td>
                </tr>
            }
        </tbody>
      </table>

    <div class="mt-5 form-control input-group">

        @* <ul class="pagination">
            <li class="page-item @(Model.PageViewModel.HasPrev ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@Model.PageViewModel.ActivePage - 1"
                   asp-route-pageSize="@Model.PageViewModel.PageSize">Previous</a>
            </li>

            
            @for(int p = 1; p <= Model.PageViewModel.PageCount; p++)
            {
                <li class="page-item @(Model.PageViewModel.ActivePage == p ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@p"
                       asp-route-pageSize="@Model.PageViewModel.PageSize">
                        @p
                    </a>
                </li>
            }
            
            <li class="page-item @(Model.PageViewModel.HasNext ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@Model.PageViewModel.ActivePage + 1"
                   asp-route-pageSize="@Model.PageViewModel.PageSize">Next</a>
            </li>
        </ul> *@

        <page-link action="Index"
                   model="@Model.PageViewModel"
                   sort-state="@Model.SortViewModel.CurrentState"
                   airline="@Model.FilterViewModel.SelectedAirline"
                   airport="@Model.FilterViewModel.SelectedAirport">
        </page-link>
                   

        <form method="get" class="input-group">
            <input hidden="hidden" name="sortState" value="@Model.SortViewModel.CurrentState" />
            <input hidden="hidden" name="airline" value="@Model.FilterViewModel.SelectedAirline" />
            <input hidden="hidden" name="airport" value="@Model.FilterViewModel.SelectedAirport" />

            <label class="form-control">Count of flights at page</label>
            <input value="@Model.PageViewModel.PageSize" name="pageSize" type="number" min="1" class="form-control" />
            <button type="submit" class="btn btn-sm btn-primary">Select</button>
        </form>
      </div>

    </div>



